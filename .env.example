# Copy to .env for local development with `npx netlify dev`.
# On Netlify, set these in Site configuration -> Environment variables instead.
# Never commit the real .env file.

# Password for the owner sign-in (required for the real, saved-to-the-cloud mode)
APP_PASSWORD=change-me-to-something-long

# Daily email digest (optional). Use a Gmail App Password, not your normal password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where to send the digest (defaults to GMAIL_USER)
DIGEST_TO=you@gmail.com
# Time zone used to decide what "today" means
DIGEST_TZ=America/Toronto
# Set to true to send the email even when nothing is due
DIGEST_ALWAYS=false
